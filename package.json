{
  "name": "godrive-mana-drivers",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "body-parser": "^2.4.0",
    "ip-address": "^10.7.6",
    "minimatch": "^11.0.8"
  },
  "scripts": {
    "dev": "npm run dev --workspace=backend",
    "dev:all": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build": "npm run build --workspace=frontend && npm run build --workspace=backend",
    "start": "npm run start --workspace=backend",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "npm test --workspace=backend",
    "test:frontend": "npm test --workspace=frontend",
    "lint": "npm run lint --workspace=frontend",
    "seed": "npm run seed --workspace=backend",
    "preview": "npm run preview --workspace=frontend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "start:backend": "npm run start --workspace=backend"
  }
}